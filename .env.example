# Public text shown in the consultation consent form.
PUBLIC_LEAD_PARTNER_NAME="Nama Pakar Faraid"

# Supabase server credentials. Never expose the secret key to browser code.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_your-server-key"

# Separate secrets for hashing contact deduplication keys and signing sessions.
LEADS_HASH_SECRET="generate-a-long-random-secret"
LEADS_SESSION_SECRET="generate-another-long-random-secret"

# Set by Vercel Cron as "Authorization: Bearer <value>" when it calls /api/health.
# Leave unset to keep the health check open.
CRON_SECRET="generate-another-long-random-secret"

# Generate each password hash with: npm run leads:hash-password -- "your password"
# Use one record for each dashboard user so audit entries identify the actor.
LEADS_DASHBOARD_USERS='[{"username":"afiq","name":"Afiq","role":"owner","passwordHash":"salt:210000:hash"},{"username":"pakar","name":"Nama Pakar","role":"partner","passwordHash":"salt:210000:hash"}]'
