---
import BaseLayout from '../layouts/BaseLayout.astro';
import CartaImage from '../components/CartaImage.astro';
import Calculator from '../components/Calculator';
import ArticleMeta from '../components/ArticleMeta.astro';
import { buildArticle, CALCULATOR_SCHEMA } from '../lib/seo';

const jsonLd = [
  buildArticle({
    headline: "Faraid Isteri Meninggal - Pembahagian Harta Pusaka Jika Isteri Meninggal Dunia",
    description: "Panduan lengkap pembahagian harta pusaka mengikut Faraid apabila isteri meninggal dunia. Bahagian suami (1/2 atau 1/4), anak-anak, dan ibu bapa mengikut Mazhab Syafi'i di Malaysia, lengkap dengan jadual, contoh pengiraan RM, dalil, dan soalan lazim.",
    path: "/faraid-isteri-meninggal/",
    hasCalculator: true,
    image: "https://www.kirafaraid.my/carta/carta-pembahagian-faraid-isteri-meninggal.png",
    datePublished: "2026-07-22",
  }),
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Berapakah bahagian suami apabila isteri meninggal dunia?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Suami mendapat 1/2 (satu perdua) daripada harta bersih jika si mati (isteri) tidak mempunyai anak, dan 1/4 (satu perempat) jika isteri mempunyai anak. Bahagian ini adalah untuk seorang suami sahaja dan tidak dikongsi."
        }
      },
      {
        "@type": "Question",
        "name": "Adakah suami mewarisi semua harta isteri jika tiada anak?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tidak. Walaupun isteri tiada anak, suami hanya mendapat 1/2. Baki harta diagihkan kepada waris lain yang layak seperti ibu, bapa, atau adik-beradik si mati mengikut susunan keutamaan Faraid."
        }
      },
      {
        "@type": "Question",
        "name": "Bolehkah suami menuntut harta sepencarian sebelum Faraid dikira?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ya. Bahagian harta sepencarian suami daripada harta yang diperoleh bersama sepanjang perkahwinan diasingkan terlebih dahulu dan bukan sebahagian pusaka. Selepas itu, suami turut mewarisi bahagian Faraid (1/2 atau 1/4) daripada baki harta pusaka isteri."
        }
      },
      {
        "@type": "Question",
        "name": "Apakah yang ditolak sebelum harta isteri dibahagikan mengikut Faraid?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sebelum Faraid dikira, kos pengurusan jenazah, hutang si mati, tuntutan harta sepencarian pasangan, dan wasiat (maksimum 1/3) hendaklah diselesaikan terlebih dahulu. Faraid hanya dikira ke atas harta bersih yang tinggal selepas potongan tersebut."
        }
      },
      {
        "@type": "Question",
        "name": "Bagaimana pembahagian jika isteri meninggalkan anak?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Jika isteri meninggalkan anak, suami mendapat 1/4 dan setiap ibu bapa si mati (jika hidup) mendapat 1/6. Baki harta menjadi Asabah kepada anak-anak, di mana anak lelaki mendapat dua kali ganda bahagian anak perempuan (nisbah 2:1)."
        }
      }
    ]
  },
  CALCULATOR_SCHEMA,
];
---

<BaseLayout
  title="Faraid Isteri Meninggal - Pembahagian Harta Pusaka Mengikut Hukum Islam"
  description="Ketahui pembahagian harta pusaka mengikut Faraid apabila isteri meninggal dunia. Bahagian suami (1/2 atau 1/4), anak-anak, dan ibu bapa mengikut Mazhab Syafi'i di Malaysia. Lengkap dengan jadual, contoh pengiraan RM, dalil, dan soalan lazim."
  jsonLd={jsonLd}
>
  <article class="max-w-4xl mx-auto space-y-12">
    <header class="text-center space-y-4">
      <h1 class="text-4xl font-bold text-warm-800">Faraid Isteri Meninggal Dunia</h1>
      <p class="text-lg text-warm-600 max-w-2xl mx-auto">Apabila seorang isteri meninggal dunia, suami mendapat <strong>1/2</strong> jika tiada anak atau <strong>1/4</strong> jika ada anak, manakala anak lelaki mengambil baki (Asabah). Panduan lengkap pembahagian harta pusaka mengikut hukum Faraid Mazhab Syafi'i di Malaysia.</p>
      <ArticleMeta datePublished="2026-07-22" />
    </header>

    <CartaImage
      src="/carta/carta-pembahagian-faraid-isteri-meninggal.png"
      alt="Carta pembahagian Faraid apabila isteri meninggal dunia: bahagian suami, ibu bapa dan anak-anak"
      caption="Carta pembahagian Faraid apabila si mati seorang isteri."
      width={2400}
      height={2528}
    />

    <div class="bg-white rounded-2xl shadow-sm border border-warm-200 p-6 md:p-10 prose prose-slate max-w-none">
      <h2 class="text-2xl font-bold text-teal-800">Ringkasan Pembahagian</h2>
      <p>Apabila isteri (si mati perempuan) meninggal dunia, harta pusaka bersihnya dibahagikan mengikut Faraid selepas ditolak kos pengurusan jenazah, hutang, wasiat, dan tuntutan harta sepencarian suami. Waris utama yang biasanya layak menerima ialah <strong>suami</strong>, <strong>anak-anak</strong>, serta <strong>ibu dan bapa</strong> si mati. Suami dan ibu bapa mendapat bahagian tetap (fardu), manakala anak lelaki mengambil baki harta sebagai Asabah.</p>

      <h2 class="text-2xl font-bold text-teal-800 mt-8">Bahagian Suami</h2>
      <p>Apabila isteri meninggal dunia, suami berhak mendapat bahagian tetap:</p>
      <ul>
        <li><strong>1/2 (satu perdua)</strong> — jika si mati tiada anak langsung.</li>
        <li><strong>1/4 (satu perempat)</strong> — jika si mati mempunyai anak (lelaki atau perempuan).</li>
      </ul>
      <p>Berbeza dengan isteri (yang boleh berbilang), suami adalah <strong>seorang sahaja</strong>, jadi bahagian ini tidak dikongsi.</p>

      <h2 class="text-2xl font-bold text-teal-800 mt-8">Bahagian Anak-anak</h2>
      <ul>
        <li><strong>Anak lelaki</strong> — Asabah (mengambil baki selepas bahagian tetap).</li>
        <li><strong>Anak perempuan sahaja (1 orang)</strong> — 1/2 daripada harta bersih.</li>
        <li><strong>Anak perempuan sahaja (2 orang ke atas)</strong> — 2/3 dikongsi sama rata.</li>
        <li><strong>Anak lelaki + anak perempuan</strong> — Baki dibahagi dengan nisbah 2:1 (anak lelaki dapat dua kali ganda anak perempuan).</li>
      </ul>
      <p>Penerangan lanjut mengenai nisbah 2:1 boleh dibaca di <a href="/faraid-anak-lelaki-dan-perempuan/" class="text-teal-700 underline">Faraid Anak Lelaki dan Perempuan</a>.</p>

      <h2 class="text-2xl font-bold text-teal-800 mt-8">Bahagian Ibu Bapa Si Mati</h2>
      <ul>
        <li><strong>Bapa</strong> — 1/6 jika ada anak. Jika tiada anak, bapa menjadi Asabah (mengambil baki).</li>
        <li><strong>Ibu</strong> — 1/6 jika ada anak. 1/3 jika tiada anak.</li>
      </ul>

      <h2 class="text-2xl font-bold text-teal-800 mt-8">Jadual Ringkas Pembahagian</h2>
      <p>Jadual di bawah meringkaskan bahagian setiap waris utama apabila seorang isteri meninggal dunia:</p>
      <div class="overflow-x-auto not-prose mt-6">
        <table class="w-full text-sm border-collapse border border-warm-200">
          <thead>
            <tr class="bg-teal-700 text-white">
              <th class="border border-teal-600 px-4 py-3 text-left font-bold">Waris</th>
              <th class="border border-teal-600 px-4 py-3 text-center font-bold">Bahagian</th>
              <th class="border border-teal-600 px-4 py-3 text-left font-bold">Syarat</th>
            </tr>
          </thead>
          <tbody>
            <tr class="bg-teal-50"><td colspan="3" class="border border-warm-200 px-4 py-2 font-bold text-teal-800">Suami</td></tr>
            <tr><td class="border border-warm-200 px-4 py-2">Suami</td><td class="border border-warm-200 px-4 py-2 text-center font-bold text-teal-700">1/2</td><td class="border border-warm-200 px-4 py-2">Si mati tiada anak</td></tr>
            <tr><td class="border border-warm-200 px-4 py-2">Suami</td><td class="border border-warm-200 px-4 py-2 text-center font-bold text-teal-700">1/4</td><td class="border border-warm-200 px-4 py-2">Si mati ada anak</td></tr>
            <tr class="bg-teal-50"><td colspan="3" class="border border-warm-200 px-4 py-2 font-bold text-teal-800">Anak-anak</td></tr>
            <tr><td class="border border-warm-200 px-4 py-2">Anak lelaki</td><td class="border border-warm-200 px-4 py-2 text-center font-bold text-teal-700">Asabah</td><td class="border border-warm-200 px-4 py-2">Mengambil baki harta</td></tr>
            <tr><td class="border border-warm-200 px-4 py-2">1 anak perempuan (tiada anak lelaki)</td><td class="border border-warm-200 px-4 py-2 text-center font-bold text-teal-700">1/2</td><td class="border border-warm-200 px-4 py-2">Seorang sahaja</td></tr>
            <tr><td class="border border-warm-200 px-4 py-2">2+ anak perempuan (tiada anak lelaki)</td><td class="border border-warm-200 px-4 py-2 text-center font-bold text-teal-700">2/3</td><td class="border border-warm-200 px-4 py-2">Dikongsi sama rata</td></tr>
            <tr><td class="border border-warm-200 px-4 py-2">Anak lelaki + anak perempuan</td><td class="border border-warm-200 px-4 py-2 text-center font-bold text-teal-700">Asabah 2:1</td><td class="border border-warm-200 px-4 py-2">Lelaki 2x perempuan</td></tr>
            <tr class="bg-teal-50"><td colspan="3" class="border border-warm-200 px-4 py-2 font-bold text-teal-800">Ibu Bapa Si Mati</td></tr>
            <tr><td class="border border-warm-200 px-4 py-2">Bapa</td><td class="border border-warm-200 px-4 py-2 text-center font-bold text-teal-700">1/6</td><td class="border border-warm-200 px-4 py-2">Si mati ada anak</td></tr>
            <tr><td class="border border-warm-200 px-4 py-2">Bapa</td><td class="border border-warm-200 px-4 py-2 text-center font-bold text-teal-700">Asabah</td><td class="border border-warm-200 px-4 py-2">Si mati tiada anak</td></tr>
            <tr><td class="border border-warm-200 px-4 py-2">Ibu</td><td class="border border-warm-200 px-4 py-2 text-center font-bold text-teal-700">1/6</td><td class="border border-warm-200 px-4 py-2">Si mati ada anak</td></tr>
            <tr><td class="border border-warm-200 px-4 py-2">Ibu</td><td class="border border-warm-200 px-4 py-2 text-center font-bold text-teal-700">1/3</td><td class="border border-warm-200 px-4 py-2">Si mati tiada anak</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-sm text-warm-500 mt-3">Nota: Datuk, nenek, dan adik-beradik hanya mewarisi apabila waris yang lebih hampir tiada. Kes khas seperti Gharrawain (suami bersama kedua ibu bapa tanpa anak) perlu disahkan oleh Mahkamah Syariah. Lihat <a href="/jadual-pembahagian-faraid/" class="text-teal-700 underline">Jadual Pembahagian Faraid</a> untuk senarai penuh.</p>

      <h2 class="text-2xl font-bold text-teal-800 mt-8">Contoh Pengiraan (RM)</h2>

      <div class="bg-teal-50 p-6 rounded-xl border border-teal-200 not-prose mt-6">
        <h3 class="font-bold text-teal-900 text-lg mb-2">Contoh 1: Ada Anak Lelaki dan Perempuan</h3>
        <p class="text-sm text-warm-700 mb-2">Seorang isteri meninggal dunia dengan harta bersih RM 240,000. Waris: 1 suami, 1 anak lelaki, 1 anak perempuan, ibu masih hidup.</p>
        <ul class="text-sm text-warm-700 space-y-1 list-disc list-inside">
          <li>Suami: 1/4 = RM 60,000</li>
          <li>Ibu: 1/6 = RM 40,000</li>
          <li>Baki (Asabah): RM 140,000 — Anak lelaki: RM 93,333, Anak perempuan: RM 46,667</li>
        </ul>
      </div>

      <div class="bg-teal-50 p-6 rounded-xl border border-teal-200 not-prose mt-6">
        <h3 class="font-bold text-teal-900 text-lg mb-2">Contoh 2: Tiada Anak</h3>
        <p class="text-sm text-warm-700 mb-2">Isteri meninggal dunia tanpa anak dengan harta bersih RM 240,000. Waris: 1 suami, ibu dan bapa masih hidup.</p>
        <ul class="text-sm text-warm-700 space-y-1 list-disc list-inside">
          <li>Suami: 1/2 = RM 120,000</li>
          <li>Ibu: 1/3 = RM 80,000</li>
          <li>Bapa: Asabah (baki) = RM 40,000</li>
        </ul>
      </div>

      <div class="bg-teal-50 p-6 rounded-xl border border-teal-200 not-prose mt-6">
        <h3 class="font-bold text-teal-900 text-lg mb-2">Contoh 3: Kes Aul (Bahagian Melebihi 1)</h3>
        <p class="text-sm text-warm-700 mb-2">Isteri meninggal dengan harta bersih RM 300,000. Waris: 1 suami, 2 anak perempuan, ibu dan bapa masih hidup. Jumlah bahagian tetap melebihi 1, jadi semua bahagian diselaraskan (Aul) daripada asas 24 kepada 30.</p>
        <ul class="text-sm text-warm-700 space-y-1 list-disc list-inside">
          <li>Suami: 1/4 &rarr; 6/30 = RM 60,000</li>
          <li>2 Anak perempuan: 2/3 &rarr; 16/30 = RM 160,000 (RM 80,000 setiap seorang)</li>
          <li>Ibu: 1/6 &rarr; 4/30 = RM 40,000</li>
          <li>Bapa: 1/6 &rarr; 4/30 = RM 40,000</li>
        </ul>
        <p class="text-sm text-warm-700 mt-2">Penerangan penuh mengenai Aul ada di <a href="/panduan-faraid/" class="text-teal-700 underline">Panduan Faraid</a>.</p>
      </div>

      <div class="bg-teal-50 p-6 rounded-xl border border-teal-200 not-prose mt-6">
        <h3 class="font-bold text-teal-900 text-lg mb-2">Contoh 4: Selepas Tolak Harta Sepencarian dan Hutang</h3>
        <p class="text-sm text-warm-700 mb-2">Jumlah harta perkahwinan RM 400,000. Suami menuntut 1/2 sebagai harta sepencarian, dan si mati meninggalkan hutang serta kos pengurusan RM 20,000.</p>
        <ul class="text-sm text-warm-700 space-y-1 list-disc list-inside">
          <li>Harta sepencarian suami (1/2): RM 200,000 — diasingkan dahulu, bukan pusaka.</li>
          <li>Tolak hutang + pengurusan jenazah: RM 20,000.</li>
          <li>Baki harta pusaka untuk Faraid: RM 180,000 — barulah dibahagi antara waris.</li>
        </ul>
        <p class="text-sm text-warm-700 mt-2">Suami turut mewarisi bahagian Faraid daripada baki RM 180,000 ini. Lihat <a href="/harta-sepencarian/" class="text-teal-700 underline">Harta Sepencarian</a> untuk penjelasan tuntutan ini.</p>
      </div>

      <h2 class="text-2xl font-bold text-teal-800 mt-8">Dalil dan Rujukan</h2>
      <p>Bahagian suami apabila isteri meninggal dunia dinyatakan dalam Surah An-Nisa' ayat 12:</p>
      <blockquote class="border-l-4 border-teal-500 bg-teal-50 p-4 text-teal-900 italic">
        "Dan bagi kamu (suami-suami) seperdua dari harta yang ditinggalkan oleh isteri-isteri kamu jika mereka tidak mempunyai anak. Tetapi jika mereka (isteri-isteri kamu) mempunyai anak maka kamu beroleh seperempat dari harta yang mereka tinggalkan, sesudah diselesaikan wasiat yang mereka buat dan sesudah dibayarkan hutangnya."
      </blockquote>
      <p>Manakala bahagian anak-anak (nisbah 2:1) dan ibu bapa (1/6) dinyatakan dalam Surah An-Nisa' ayat 11:</p>
      <blockquote class="border-l-4 border-teal-500 bg-teal-50 p-4 text-teal-900 italic">
        "Allah perintahkan kamu mengenai (pembahagian harta pusaka untuk) anak-anak kamu, iaitu bahagian seorang anak lelaki menyamai bahagian dua orang anak perempuan."
      </blockquote>
      <p>Pengiraan di laman ini mengikut <strong>Mazhab Syafi'i</strong> sebagaimana yang diamalkan di Malaysia. Kes-kes rumit (seperti Gharrawain, adik-beradik, datuk atau nenek) hendaklah disahkan oleh Mahkamah Syariah. Untuk rujukan rasmi dan pengesahan pembahagian pusaka, sila rujuk:</p>
      <ul>
        <li><a href="https://www.islam.gov.my" target="_blank" rel="noopener noreferrer" class="text-teal-700 underline">Jabatan Kemajuan Islam Malaysia (JAKIM)</a></li>
        <li><a href="https://www.amanahraya.com.my" target="_blank" rel="noopener noreferrer" class="text-teal-700 underline">Amanah Raya Berhad (ARB)</a> — pentadbiran harta pusaka</li>
        <li><a href="https://www.jksm.gov.my" target="_blank" rel="noopener noreferrer" class="text-teal-700 underline">Jabatan Kehakiman Syariah Malaysia (JKSM)</a> — sijil Faraid Mahkamah Syariah</li>
      </ul>
    </div>

    <div class="space-y-4">
      <h2 class="text-2xl font-bold text-warm-800 text-center">Kira Pembahagian Faraid Anda</h2>
      <p class="text-warm-600 text-center">Gunakan kalkulator di bawah untuk mengira pembahagian sebenar berdasarkan situasi anda.</p>
      <Calculator client:visible embedded />
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-warm-200 p-6 md:p-10 prose prose-slate max-w-none">
      <h2 class="text-2xl font-bold text-teal-800">Soalan Lazim (FAQ)</h2>

      <h3 class="text-lg font-bold text-warm-800">Berapakah bahagian suami apabila isteri meninggal dunia?</h3>
      <p>Suami mendapat 1/2 (satu perdua) daripada harta bersih jika si mati (isteri) tidak mempunyai anak, dan 1/4 (satu perempat) jika isteri mempunyai anak. Bahagian ini adalah untuk seorang suami sahaja dan tidak dikongsi.</p>

      <h3 class="text-lg font-bold text-warm-800 mt-4">Adakah suami mewarisi semua harta isteri jika tiada anak?</h3>
      <p>Tidak. Walaupun isteri tiada anak, suami hanya mendapat 1/2. Baki harta diagihkan kepada waris lain yang layak seperti ibu, bapa, atau adik-beradik si mati mengikut susunan keutamaan Faraid.</p>

      <h3 class="text-lg font-bold text-warm-800 mt-4">Bolehkah suami menuntut harta sepencarian sebelum Faraid dikira?</h3>
      <p>Ya. Bahagian harta sepencarian suami daripada harta yang diperoleh bersama sepanjang perkahwinan diasingkan terlebih dahulu dan bukan sebahagian pusaka. Selepas itu, suami turut mewarisi bahagian Faraid (1/2 atau 1/4) daripada baki harta pusaka isteri.</p>

      <h3 class="text-lg font-bold text-warm-800 mt-4">Apakah yang ditolak sebelum harta isteri dibahagikan mengikut Faraid?</h3>
      <p>Sebelum Faraid dikira, kos pengurusan jenazah, hutang si mati, tuntutan harta sepencarian pasangan, dan wasiat (maksimum 1/3) hendaklah diselesaikan terlebih dahulu. Faraid hanya dikira ke atas harta bersih yang tinggal selepas potongan tersebut.</p>

      <h3 class="text-lg font-bold text-warm-800 mt-4">Bagaimana pembahagian jika isteri meninggalkan anak?</h3>
      <p>Jika isteri meninggalkan anak, suami mendapat 1/4 dan setiap ibu bapa si mati (jika hidup) mendapat 1/6. Baki harta menjadi Asabah kepada anak-anak, di mana anak lelaki mendapat dua kali ganda bahagian anak perempuan (nisbah 2:1).</p>
    </div>

    <div class="text-center text-sm text-warm-500 space-x-4">
